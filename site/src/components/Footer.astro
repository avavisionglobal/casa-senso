---
// Pied de page v4 (13.11.2026), inspiré du site crème (référence de Diego) : grand logo, colonnes à titres
// en minuscules avec point d'interrogation, badge circulaire qui tourne, Instagram en bas à droite.
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { site } from '../data/site';
import traitMaison from '../assets/images/traits/batisse-encre.png';
const instagram = 'https://www.instagram.com/casa_senso.ch/';
---
<footer class="site-footer">
  <div class="conteneur pied">
    <div class="pied-gauche">
      <Logo class="footer-logo" />
      <div class="cols">
        <div class="col">
          <h2 class="titre-serif">me contacter&nbsp;?</h2>
          <p>{site.person}</p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
          <a class="pied-rdv" href="/contact#formulaire">Prendre rendez-vous <span aria-hidden="true">→</span></a>
        </div>
        <div class="col">
          <h2 class="titre-serif">où me trouver&nbsp;?</h2>
          <p>{site.cityContact}</p>
          <p>{site.country}</p>
        </div>
        <nav class="col" aria-label="Pages du site">
          <h2 class="titre-serif">le site</h2>
          <p><a href="/agence">L'agence</a></p>
          <p><a href="/prestations">Prestations</a></p>
          <p><a href="/realisations">Réalisations</a></p>
          <p><a href="/contact">Contact</a></p>
        </nav>
      </div>
    </div>

    <div class="badge" aria-hidden="true">
      <svg class="badge-texte" viewBox="0 0 200 200">
        <defs><path id="cercle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
        <text><textPath href="#cercle" startOffset="0">aménagement · décoration · clé en main · </textPath></text>
      </svg>
      <Image class="badge-trait" src={traitMaison} alt="" width={120} />
    </div>
  </div>

  <div class="conteneur bas">
    <p>© 2026 Casa Senso. Tous droits réservés · <a href="/politique-de-confidentialite">Politique de confidentialité</a></p>
    <a class="insta" href={instagram} target="_blank" rel="noopener">
      <span>@casa_senso.ch</span>
      <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="5" width="38" height="38" rx="11" /><circle cx="24" cy="24" r="9" /><circle cx="35" cy="13" r="2.4" class="point" /></svg>
    </a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--paper); padding: 72px 0 36px; }
  .pied { display: grid; grid-template-columns: 1fr auto; gap: 60px; align-items: start; }
  .pied :global(.footer-logo) { width: 300px; }
  .cols { margin-top: 52px; display: grid; grid-template-columns: repeat(3, minmax(0, 260px)); gap: 48px; }
  .col h2 { font-size: 30px; margin-bottom: 14px; }
  .col p { font-size: 17px; line-height: 1.6; }
  .col a { transition: color .3s var(--ease); }
  .col a:hover { color: var(--accent); }
  .pied-rdv { display: inline-block; margin-top: 16px; font-weight: 600; font-size: 15px; color: var(--accent); }
  .pied-rdv span { display: inline-block; transition: transform .45s var(--ease); }
  .pied-rdv:hover span { transform: translateX(4px); }

  .badge { position: relative; width: 220px; height: 220px; margin-right: 10px; overflow: hidden; border-radius: 50%; }
  .badge-texte { width: 100%; height: 100%; }
  .badge-texte text { font-family: var(--serif); font-size: 19px; letter-spacing: 2.4px; fill: var(--ink); }
  @media (prefers-reduced-motion: no-preference) { .badge-texte { animation: tourne 26s linear infinite; } }
  @keyframes tourne { to { transform: rotate(360deg); } }
  .badge :global(.badge-trait) { position: absolute; left: 50%; top: 50%; width: 92px; height: auto; transform: translate(-50%, -50%); }

  .bas { margin-top: 56px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .bas p { font-size: 14px; color: var(--muted); }
  .bas p a { text-decoration: underline; text-underline-offset: 3px; }
  .insta { display: inline-flex; align-items: center; gap: 18px; color: var(--ocre); font-weight: 600; font-size: 17px; transition: color .3s var(--ease); }
  .insta svg { width: 56px; height: 56px; }
  .insta rect, .insta circle { fill: none; stroke: currentColor; stroke-width: 3.4; }
  .insta .point { fill: currentColor; stroke: none; }
  .insta:hover { color: var(--accent); }

  @media (max-width: 999px) {
    .site-footer { padding: 48px 0 28px; }
    .pied { grid-template-columns: 1fr; gap: 36px; }
    .pied :global(.footer-logo) { width: 220px; }
    .cols { margin-top: 36px; grid-template-columns: 1fr 1fr; gap: 30px 20px; }
    .col:first-child { grid-column: 1 / -1; }
    .col h2 { font-size: 24px; margin-bottom: 8px; }
    .col p { font-size: 16px; }
    .badge { width: 150px; height: 150px; justify-self: end; margin: -20px 0 0; }
    .badge :global(.badge-trait) { width: 62px; }
    .bas { margin-top: 32px; flex-direction: column-reverse; align-items: flex-start; }
    .insta svg { width: 44px; height: 44px; }
  }
</style>
