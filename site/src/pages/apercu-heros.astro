---
// Page de comparaison des grands visuels (13.11.2026). Hors index ; à supprimer avant la mise en ligne.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowButton from '../components/ArrowButton.astro';

import heroSalon from '../assets/images/accueil/hero-cannes-salon.jpg';
import heroSejour from '../assets/images/accueil/hero-cannes-sejour.jpg';
import heroCuisine from '../assets/images/accueil/hero-cannes-cuisine.jpg';
import heroChambre from '../assets/images/accueil/hero-cannes-chambre.jpg';
import cannesConsole from '../assets/images/accueil/cannes-console.jpg';
import cannesBain from '../assets/images/accueil/cannes-salle-de-bain.jpg';
import maisonSalon from '../assets/images/accueil/maison-salon.jpg';
import maisonSalle from '../assets/images/accueil/maison-salle-a-manger.jpg';
import maisonCanape from '../assets/images/accueil/maison-canape.jpg';
import igMiroirs from '../assets/images/accueil/insta-cannes-miroirs.jpg';
import igChambre from '../assets/images/accueil/insta-maison-chambre.jpg';

const slides = [
  { src: heroSalon, alt: "Salon de l'appartement de Cannes" },
  { src: heroSejour, alt: "Séjour de l'appartement de Cannes" },
  { src: heroCuisine, alt: "Cuisine de l'appartement de Cannes" },
  { src: heroChambre, alt: "Chambre de l'appartement de Cannes" },
];
const bande = [
  { src: cannesConsole, alt: "Entrée de l'appartement de Cannes" },
  { src: maisonSalon, alt: 'Salon de la maison de famille' },
  { src: cannesBain, alt: "Salle de bains de l'appartement de Cannes" },
  { src: maisonSalle, alt: 'Salle à manger de la maison de famille' },
  { src: igMiroirs, alt: 'Miroirs ronds dorés' },
  { src: maisonCanape, alt: 'Canapé de la maison de famille' },
  { src: igChambre, alt: 'Chevet et bouquet de fleurs' },
];
---
<Base title="Aperçu des grands visuels · Casa Senso" description="Page de travail : où placer le texte du grand visuel.">
  <div class="note"><p class="mention">Page de travail · où placer le texte du grand visuel · 13.11.2026</p></div>

  <p class="label"><span>1</span> Au milieu : titre centré sur la photo, voile léger sur toute l’image</p>
  <section class="hero v1" data-carousel>
    {slides.map((s, i) => (<figure class:list={['slide', { 'is-active': i === 0 }]}><Image src={s.src} alt={s.alt} widths={[1024, 1600, 2400]} sizes="100vw" /></figure>))}
    <div class="txt"><p class="kicker">Casa Senso · Neuchâtel</p><h1 class="titre-serif">De l'idée à la <em>réalisation</em></h1><p class="sous">Le plaisir de choisir. La liberté de déléguer.</p></div>
  </section>

  <p class="label"><span>2</span> Au milieu, dans un cadre de verre dépoli</p>
  <section class="hero v2" data-carousel>
    {slides.map((s, i) => (<figure class:list={['slide', { 'is-active': i === 0 }]}><Image src={s.src} alt={s.alt} widths={[1024, 1600, 2400]} sizes="100vw" /></figure>))}
    <div class="txt"><p class="kicker">Casa Senso · Neuchâtel</p><h1 class="titre-serif">De l'idée à la <em>réalisation</em></h1><p class="sous">Le plaisir de choisir. La liberté de déléguer.</p></div>
  </section>

  <p class="label"><span>3</span> À gauche, au milieu de la hauteur, sur un dégradé latéral</p>
  <section class="hero v3" data-carousel>
    {slides.map((s, i) => (<figure class:list={['slide', { 'is-active': i === 0 }]}><Image src={s.src} alt={s.alt} widths={[1024, 1600, 2400]} sizes="100vw" /></figure>))}
    <div class="txt"><p class="kicker">Casa Senso · Neuchâtel</p><h1 class="titre-serif">De l'idée<br />à la <em>réalisation</em></h1><p class="sous">Le plaisir de choisir.<br />La liberté de déléguer.</p></div>
  </section>

  <p class="label"><span>4</span> En bas au centre, très grand, sur un dégradé plus marqué</p>
  <section class="hero v4" data-carousel>
    {slides.map((s, i) => (<figure class:list={['slide', { 'is-active': i === 0 }]}><Image src={s.src} alt={s.alt} widths={[1024, 1600, 2400]} sizes="100vw" /></figure>))}
    <div class="txt"><h1 class="titre-serif">De l'idée à la <em>réalisation</em></h1><p class="sous">Le plaisir de choisir. La liberté de déléguer.</p></div>
  </section>
  <div class="fin"></div>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c, n) => {
    const slides = [...c.querySelectorAll<HTMLElement>('.slide')];
    if (reduced || slides.length < 2) return;
    let i = 0;
    setTimeout(() => setInterval(() => { slides[i].classList.remove('is-active'); i = (i + 1) % slides.length; slides[i].classList.add('is-active'); }, 6000), n * 900);
  });
</script>

<style>
  .note { padding: 18px var(--gutter); border-bottom: 1px solid var(--line); }
  .label { display: flex; align-items: center; gap: 14px; padding: 48px var(--gutter) 16px; font-size: 16px; color: var(--muted); }
  .label span { display: inline-grid; place-items: center; min-width: 40px; height: 40px; padding: 0 12px; border-radius: 999px; background: var(--ink); color: var(--paper); font-weight: 600; }
  .fin { height: 120px; }

  .hero { position: relative; height: calc(100svh - var(--header-h)); min-height: 620px; max-height: 1000px; overflow: hidden; background: var(--grey); color: #fff; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.8s ease; }
  .slide.is-active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .slide :global(img) { transform: scale(1.12); transition: transform 9s linear; }
    .slide.is-active :global(img) { transform: scale(1); }
  }
  .txt { position: absolute; z-index: 2; }
  .kicker { font-weight: 500; font-size: 14px; letter-spacing: .3em; text-transform: uppercase; }
  .hero h1 { line-height: 1.02; }
  .hero h1 em { color: #F1E3C3; }
  .v1 h1 em, .v2 h1 em { color: #FFF1D6; }
  .v1 .sous, .v2 .sous { font-weight: 500; }
  .sous { font-size: 22px; }

  /* 1 · Au milieu, voile léger */
  .v1::after { content: ''; position: absolute; inset: 0; z-index: 1; background: radial-gradient(ellipse at center, rgba(20,16,12,.55) 0%, rgba(20,16,12,.32) 55%, rgba(20,16,12,.18) 100%); }
  .v1 .txt { inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 18px; padding: 0 24px; text-shadow: 0 2px 24px rgba(0,0,0,.25); }
  .v1 h1 { font-size: clamp(48px, 7.4vw, 112px); }

  /* 2 · Verre dépoli */
  .v2 .txt { left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(820px, calc(100% - 40px)); padding: 48px 56px; border-radius: 28px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px;
    background: rgba(30, 26, 23, .32); border: 1px solid rgba(255,255,255,.28); backdrop-filter: blur(14px) saturate(1.1); -webkit-backdrop-filter: blur(14px) saturate(1.1); box-shadow: 0 30px 80px -40px rgba(0,0,0,.45); text-shadow: 0 1px 16px rgba(0,0,0,.25); }
  .v2 h1 { font-size: clamp(42px, 5.8vw, 84px); }

  /* 3 · À gauche, dégradé latéral */
  .v3::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to right, rgba(20,16,12,.62) 0%, rgba(20,16,12,.35) 38%, rgba(20,16,12,0) 65%); }
  .v3 .txt { left: var(--gutter); top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 20px; max-width: 640px; }
  .v3 h1 { font-size: clamp(48px, 6.6vw, 100px); }

  /* 4 · En bas au centre */
  .v4::after { content: ''; position: absolute; inset: auto 0 0 0; height: 70%; z-index: 1; background: linear-gradient(to top, rgba(20,16,12,.72) 0%, rgba(20,16,12,.35) 45%, rgba(20,16,12,0) 100%); }
  .v4 .txt { left: 0; right: 0; bottom: 64px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding: 0 20px; }
  .v4 h1 { font-size: clamp(52px, 8.4vw, 128px); }

  @media (max-width: 999px) {
    .label { padding-top: 36px; font-size: 14px; }
    .hero { height: min(720px, calc(100svh - var(--header-h))); min-height: 540px; }
    .sous { font-size: 18px; }
    .kicker { font-size: 12px; }
    .v2 .txt { padding: 32px 22px; }
    .v3::after { background: linear-gradient(to top, rgba(20,16,12,.65), rgba(20,16,12,.15) 70%); }
    .v3 .txt { top: auto; bottom: 40px; transform: none; right: var(--gutter); }
    .v4 .txt { bottom: 40px; }
  }
</style>
