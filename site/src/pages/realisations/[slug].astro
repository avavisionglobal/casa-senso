---
// Page projet (13.11.2026), sur la structure des pages projet de madah.fr (référence de Diego) :
// titre + missions + 3 photos · accroche · 4 photos · récit en deux colonnes · avant (diaporama) · galerie · contact · projet suivant.
import { Image, getImage } from 'astro:assets';
import { ids, pageUrl, abs } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import ArrowButton from '../../components/ArrowButton.astro';
import { projets } from '../../data/projets';

export function getStaticPaths() {
  return projets.map((p, i) => ({ params: { slug: p.slug }, props: { i } }));
}
const { i } = Astro.props as { i: number };
const p = projets[i];
const prec = projets[(i - 1 + projets.length) % projets.length];
const suiv = projets[(i + 1) % projets.length];

// Les photos gardent leur format d'origine (14.11.2026) : plus de cadres verticaux fixes qui coupaient
// la moitié des photos horizontales. Chaque bloc est rangé en lignes « justifiées » : dans une ligne,
// toutes les photos ont la même hauteur et chacune garde son rapport largeur/hauteur.
const LARGEUR = 1320;
const ratio = (m: ImageMetadata) => m.width / m.height;
// 18.11.2026 : au plus 4 photos par ligne, et aucune photo plus étroite que 200 px sur 1320
// (sinon des bandes illisibles à 1024 px) ; la ligne la plus courte ouvre le bloc plutôt que de le fermer.
function rangs(imgs: ImageMetadata[], hauteurVisee: number) {
  const total = imgs.reduce((t, m) => t + ratio(m), 0);
  let n = Math.max(1, Math.round(total / (LARGEUR / hauteurVisee)));
  let out = decoupe(imgs, n, total);
  const ok = (rs: ImageMetadata[][]) => rs.every((r) => {
    const s = r.reduce((t, m) => t + ratio(m), 0);
    return r.length <= 4 && r.every((m) => (ratio(m) / s) * LARGEUR >= 200);
  });
  while (!ok(out) && n < Math.ceil(imgs.length / 2)) { n++; out = decoupe(imgs, n, total); }
  if (out.length > 1 && out[out.length - 1].length < out[0].length) out.unshift(out.pop()!);
  return out.map((rang) => ({ rang, somme: rang.reduce((t, m) => t + ratio(m), 0) }));
}
function decoupe(imgs: ImageMetadata[], n: number, total: number) {
  const cible = total / n;
  const out: ImageMetadata[][] = [];
  let cur: ImageMetadata[] = [], somme = 0;
  for (const m of imgs) {
    if (cur.length && somme + ratio(m) / 2 > cible && out.length < n - 1) { out.push(cur); cur = []; somme = 0; }
    cur.push(m); somme += ratio(m);
  }
  if (cur.length) out.push(cur);
  return out;
}
// Téléphone : photos verticales deux par deux ; s'il en reste une seule, elle prend toute la largeur.
const seule = (blocs: { rang: ImageMetadata[] }[]) => {
  const demies = blocs.flatMap((b) => b.rang).filter((m) => ratio(m) < 0.95);
  return demies.length % 2 ? demies[demies.length - 1] : null;
};
const tailles = (m: ImageMetadata, somme: number, largeur = LARGEUR) =>
  `(max-width: 999px) ${ratio(m) >= 0.95 ? 100 : 50}vw, ${Math.round((ratio(m) / somme) * largeur)}px`;
const hautPaysage = p.haut.every((m) => ratio(m) > 1.2);
const hautSomme = p.haut.reduce((t, m) => t + ratio(m), 0);
const rangee = rangs(p.rangee, 440);
const galerie = rangs(p.galerie, 340);
const seuleRangee = seule(rangee);
const seuleGalerie = seule(galerie);
// Diaporama « avant » : cadre vertical si la plupart des photos le sont ; une photo d'un autre format y est montrée entière.
const avantVertical = p.avant ? p.avant.filter((m) => ratio(m) < 1).length > p.avant.length / 2 : false;
const cadreAvant = avantVertical ? 3 / 4 : 3 / 2;
// Données structurées (22.11.2026) : la réalisation comme œuvre de Casa Senso, avec ses photos principales.
// Aucun propriétaire ni adresse : seulement le lieu affiché sur la page.
const chemin = `/realisations/${p.slug}`;
const photos = await Promise.all([p.couverture, ...p.haut.filter((m) => m !== p.couverture)].map((src) => getImage({ src, width: 1400, format: 'jpg', quality: 80 })));
const schema = [{
  '@type': 'CreativeWork', '@id': `${pageUrl(chemin)}#realisation`,
  name: p.titre, description: p.accroche, genre: p.type, keywords: p.missions.join(', '),
  image: photos.map((ph) => abs(ph.src)),
  creator: { '@id': ids.entreprise },
  ...(p.lieu && { locationCreated: { '@type': 'Place', name: p.lieu } }),
  inLanguage: 'fr-CH',
  mainEntityOfPage: { '@id': ids.page(chemin) },
}];
---
<Base image={p.couverture} fil={p.titre} schema={schema} title={`${p.titre} | Réalisation Casa Senso`} description={`${p.titre} : ${p.missions.join(', ').toLowerCase()}. Une réalisation Casa Senso, aménagement et décoration à Neuchâtel.`}>
  <!-- 1. En-tête : titre, missions, 3 photos -->
  <header class="tete conteneur">
    <div class="tete-texte" data-stagger="100">
      <a class="retour" href="/realisations"><span aria-hidden="true">←</span> Réalisations</a>
      <h1 class="titre-serif" set:html={p.titreHtml} />
      <ul class="missions">{p.missions.map((m) => <li>{m}</li>)}</ul>
      <dl class="fiche">{p.lieu && <div><dt>Lieu</dt><dd>{p.lieu}</dd></div>}<div><dt>Type</dt><dd>{p.type}</dd></div></dl>
    </div>
    <div class:list={['tete-photos', hautPaysage ? 'mosaique' : 'rang']} data-stagger="130" data-stagger-anim="reveal">
      {p.haut.map((src, k) => (
        <figure style={hautPaysage ? undefined : `--r:${ratio(src)}`}>
          <Image src={src} alt={`${p.titre}, photo ${k + 1}`} widths={[400, 700, 1000, 1400]}
            sizes={hautPaysage ? (k === 0 ? '(max-width: 999px) 66vw, 580px' : '(max-width: 999px) 33vw, 290px') : `(max-width: 999px) 33vw, ${Math.round((ratio(src) / hautSomme) * 860)}px`}
            loading={k === 0 ? 'eager' : 'lazy'} />
        </figure>
      ))}
    </div>
  </header>

  <!-- 2. Accroche -->
  <section class="accroche"><p class="titre-serif conteneur" data-anim="up">{p.accroche}</p></section>

  <!-- 3. Rangée de 4 photos -->
  <section class="rangee rangs conteneur" aria-label="Photos du projet">
    {rangee.map(({ rang, somme }, l) => (
      <div class="rang" data-stagger="110" data-stagger-anim="reveal">
        {rang.map((src, k) => (
          <figure class:list={[ratio(src) >= 0.95 ? 'pleine' : 'demie', { seule: src === seuleRangee }]} style={`--r:${ratio(src)}`}>
            <Image src={src} alt={`${p.titre}, détail ${l * 10 + k + 1}`} widths={[400, 700, 1000, 1400]} sizes={tailles(src, somme)} />
          </figure>
        ))}
      </div>
    ))}
  </section>

  <!-- 4. Récit en deux colonnes -->
  <!-- 18.11.2026 : une seule colonne de lecture (62 caractères), dans l'ordre du récit ; les deux colonnes
       d'avant se déséquilibraient selon la longueur des textes. -->
  <section class="recit conteneur" aria-labelledby="recit-titre">
    <p class="mention" id="recit-titre" data-anim="up">Le projet</p>
    <div class="recit-texte" data-stagger="100">{p.recit.map((r) => <p class:list={{ citation: r.citation }}>{r.p}</p>)}</div>
  </section>

  <!-- 5. Avant (diaporama) -->
  {p.avant && (
    <section class="avant" aria-labelledby="avant-titre">
      <div class="conteneur avant-in">
        <div class="avant-tete" data-anim="up">
          <p class="mention">Avant</p>
          <h2 id="avant-titre" class="titre-serif">{p.avantTitre}</h2>
          <div class="fleches">
            <button type="button" class="fl prec" aria-label="Photo précédente">←</button>
            <span class="compteur" aria-live="polite">1 / {p.avant.length}</span>
            <button type="button" class="fl suiv" aria-label="Photo suivante">→</button>
          </div>
        </div>
        <div class:list={['diapo', { verticale: avantVertical }]} style={`--cadre:${cadreAvant}`} data-anim="up">
          {p.avant.map((src, k) => <figure class:list={['d', { actif: k === 0, entiere: (ratio(src) < 1) !== avantVertical }]}><Image src={src} alt={`${p.titre}, avant les travaux, photo ${k + 1}`} widths={[600, 1000, 1400]} sizes={avantVertical ? '(max-width: 999px) 100vw, 560px' : '(max-width: 999px) 100vw, 60vw'} /></figure>)}
        </div>
        <div class="vignettes">
          {p.avant.map((src, k) => <button type="button" class:list={['v', { actif: k === 0 }]} aria-label={`Afficher la photo ${k + 1}`}><Image src={src} alt="" widths={[200]} sizes="120px" /></button>)}
        </div>
      </div>
    </section>
  )}

  <!-- 6. Galerie -->
  <section class="galerie rangs conteneur" aria-label="Galerie">
    {galerie.map(({ rang, somme }, l) => (
      <div class="rang" data-stagger="80" data-stagger-anim="reveal">
        {rang.map((src, k) => (
          <figure class:list={[ratio(src) >= 0.95 ? 'pleine' : 'demie', { seule: src === seuleGalerie }]} style={`--r:${ratio(src)}`}>
            <Image src={src} alt={`${p.titre}, photo ${l * 10 + k + 5}`} widths={[400, 700, 1000, 1400]} sizes={tailles(src, somme)} />
          </figure>
        ))}
      </div>
    ))}
  </section>

  <!-- 7. Contact -->
  <section class="conteneur cta">
    <div class="carte" data-anim="up">
      <div>
        <h2 class="titre-serif">Vous avez un <em>projet</em>&nbsp;?<br />Parlons-en&nbsp;ensemble.</h2>
        <p>Une pièce à repenser, une maison à aménager ou des locaux à mettre en valeur : dites-moi en quelques lignes ce que vous imaginez, je vous recontacte rapidement.</p>
      </div>
      <ArrowButton href="/contact#formulaire" label="Prendre rendez-vous" />
    </div>
  </section>

  <!-- 8. Projets précédent / suivant -->
  <nav class="conteneur suite" aria-label="Autres réalisations">
    <a href={`/realisations/${prec.slug}`} class="prec-l"><span aria-hidden="true">←</span> {prec.titre}</a>
    <a href={`/realisations/${suiv.slug}`} class="suiv-l">{suiv.titre} <span aria-hidden="true">→</span></a>
  </nav>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.avant').forEach((sec) => {
    const slides = [...sec.querySelectorAll<HTMLElement>('.d')];
    const thumbs = [...sec.querySelectorAll<HTMLElement>('.v')];
    const cpt = sec.querySelector('.compteur');
    let i = 0;
    const go = (n: number) => {
      slides[i].classList.remove('actif'); thumbs[i].classList.remove('actif');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('actif'); thumbs[i].classList.add('actif');
      if (cpt) cpt.textContent = `${i + 1} / ${slides.length}`;
    };
    sec.querySelector('.prec')?.addEventListener('click', () => go(i - 1));
    sec.querySelector('.suiv')?.addEventListener('click', () => go(i + 1));
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
  });
</script>

<style>
  .tete { padding-top: 56px; padding-bottom: 80px; display: grid; grid-template-columns: 4fr 8fr; gap: 56px; align-items: end; }
  .tete > * { min-width: 0; }
  .retour { display: inline-block; margin-bottom: 26px; font-weight: 500; font-size: 14px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); transition: color .3s var(--ease); }
  .retour:hover { color: var(--accent); }
  h1 { font-size: 56px; line-height: 1.05; }
  h1 :global(em), .cta h2 em { color: var(--accent); }
  .missions { list-style: none; margin: 26px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .missions li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 17px; }
  .fiche { margin: 22px 0 0; display: grid; gap: 10px; }
  .fiche div { display: grid; grid-template-columns: 64px 1fr; align-items: baseline; gap: 12px; }
  .fiche dt { font-weight: 500; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .fiche dd { margin: 0; font-family: var(--serif); font-size: 19px; text-wrap: balance; }
  /* En-tête : photos horizontales en mosaïque (une grande, deux superposées), sinon une ligne justifiée. */
  .tete-photos.mosaique { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px; }
  .mosaique figure:first-child { grid-row: span 2; aspect-ratio: 3 / 2; }
  .mosaique figure { position: relative; min-height: 0; }
  .mosaique figure :global(img) { position: absolute; inset: 0; }
  .tete-photos.rang { display: flex; gap: 12px; }
  figure { margin: 0; overflow: hidden; border-radius: var(--radius); background: var(--grey); }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  /* Ligne justifiée : chaque photo garde son format, la ligne entière a une seule hauteur. */
  .rang > figure { flex: var(--r) 1 0; aspect-ratio: var(--r); min-width: 0; }
  .rangs { display: grid; gap: 12px; }
  .rangs .rang { display: flex; gap: 12px; }
  .tete-photos figure:hover :global(img), .rangee figure:hover :global(img), .galerie figure:hover :global(img) { transform: scale(1.05); }

  .accroche { background: var(--card); padding: 90px 0; text-align: center; }
  .accroche p { max-width: 900px; font-size: 36px; line-height: 1.3; }

  .rangee { padding-top: 90px; }

  .recit { padding-top: 80px; padding-bottom: 100px; display: grid; grid-template-columns: 4fr 8fr; gap: 56px; }
  .recit .mention { padding-top: 10px; }
  .recit-texte { display: grid; gap: 22px; max-width: 62ch; }
  .recit p { font-size: 18px; line-height: 1.75; }
  .recit p.citation { font-family: var(--serif); font-size: 26px; line-height: 1.4; color: var(--accent); }

  .avant { background: var(--card); padding: 90px 0; }
  .avant-in { display: grid; grid-template-columns: 4fr 8fr; grid-template-rows: auto auto; gap: 24px 56px; }
  .avant-in > * { min-width: 0; }
  .avant-tete { grid-row: span 2; display: flex; flex-direction: column; gap: 14px; align-self: start; position: sticky; top: calc(var(--header-h) + 32px); }
  .avant h2 { font-size: 40px; }
  .fleches { margin-top: 12px; display: flex; align-items: center; gap: 16px; }
  .fl { width: 52px; height: 52px; border-radius: 999px; border: 1px solid var(--ink); background: transparent; font-size: 20px; cursor: pointer; transition: background-color .3s var(--ease), color .3s var(--ease); }
  .fl:hover { background: var(--ink); color: var(--paper); }
  .compteur { font-family: var(--serif); font-size: 18px; min-width: 52px; text-align: center; }
  .diapo { position: relative; aspect-ratio: var(--cadre, 1.5); border-radius: var(--radius); overflow: hidden; background: var(--grey); }
  .diapo.verticale { width: min(100%, calc(78svh * 0.75), 600px); justify-self: end; }
  .d.entiere :global(img) { object-fit: contain; }
  .avant-in:has(.verticale) .vignettes { justify-content: flex-end; }
  .d { position: absolute; inset: 0; opacity: 0; transition: opacity .8s var(--ease); border-radius: 0; }
  .d.actif { opacity: 1; }
  .vignettes { display: flex; gap: 10px; flex-wrap: wrap; }
  .v { width: 84px; height: 64px; padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; cursor: pointer; opacity: .55; background: none; transition: opacity .3s, border-color .3s; }
  .verticale ~ .vignettes .v { width: 54px; height: 72px; }
  .v.actif { opacity: 1; border-color: var(--accent); }
  .v :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .galerie { padding-top: 100px; }
  .recit + .galerie { padding-top: 0; }

  .cta { padding-top: 110px; }
  .carte { background: var(--card); border-radius: calc(var(--radius) + 8px); padding: 60px 64px; display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .carte :global(.btn-outline) { justify-self: start; }
  .carte h2 { font-size: 40px; }
  .carte p { margin-top: 16px; max-width: 560px; font-size: 17px; line-height: 1.7; }

  .suite { padding-top: 56px; padding-bottom: 100px; display: flex; justify-content: space-between; gap: 20px; }
  .suite a { font-family: var(--serif); font-size: 26px; transition: color .3s var(--ease); }
  .suite a:hover { color: var(--accent); }
  .suite span { display: inline-block; transition: transform .45s var(--ease); }
  .prec-l:hover span { transform: translateX(-4px); }
  .suiv-l:hover span { transform: translateX(4px); }

  @media (max-width: 1199px) and (min-width: 1000px) {
    h1 { font-size: 46px; }
    .avant-in { grid-template-columns: 5fr 7fr; gap: 24px 40px; }
    .avant h2 { font-size: 32px; }
  }
  @media (max-width: 999px) {
    .tete { grid-template-columns: 1fr; gap: 32px; padding-top: 36px; padding-bottom: 56px; }
    h1 { font-size: 38px; }
    .tete-photos { gap: 8px; }
    .accroche { padding: 56px 0; }
    .accroche p { font-size: 24px; }
    .rangee { padding-top: 56px; }
    .rangs, .rangs .rang { gap: 8px; }
    .tete-photos.mosaique, .tete-photos.rang { gap: 8px; }
    /* Tablette : photo « avant » verticale plafonnée pour voir flèches et vignettes avec elle. */
    .diapo.verticale { width: min(100%, calc(62svh * 0.75), 480px); justify-self: center; }
    .avant-in:has(.verticale) .vignettes { justify-content: center; }
    .avant-tete { position: static; }
    .recit { grid-template-columns: 1fr; gap: 16px; padding-top: 48px; padding-bottom: 64px; }
    .recit .mention { padding-top: 0; }
    .recit p { font-size: 17px; }
    .recit p.citation { font-size: 22px; }
    .avant { padding: 56px 0; }
    .avant-in { grid-template-columns: 1fr; }
    .avant-tete { grid-row: auto; }
    .avant h2 { font-size: 30px; }
    .vignettes { flex-wrap: nowrap; overflow-x: auto; gap: 6px; scrollbar-width: none; }
    .v, .verticale ~ .vignettes .v { flex: none; width: min(52px, calc((100% - 30px) / 6)); height: auto; aspect-ratio: 1; }
    .galerie { padding-top: 56px; }
    .cta { padding-top: 64px; }
    .carte { grid-template-columns: 1fr; padding: 36px 24px; gap: 26px; }
    .carte h2 { font-size: clamp(24px, 7vw, 30px); }
    .suite { padding-bottom: 64px; }
    .suite a { font-size: 21px; }
  }
  /* Téléphone : photo horizontale ou carrée sur toute la largeur, photos verticales deux par deux. */
  @media (max-width: 599px) {
    .rangs { grid-template-columns: 1fr 1fr; grid-auto-flow: dense; }
    .rangs .rang { display: contents; }
    .rangs figure.pleine, .rangs figure.seule { grid-column: 1 / -1; aspect-ratio: var(--r); }
    .rangs figure.demie:not(.seule) { aspect-ratio: 7 / 10; }
    .diapo.verticale { width: 100%; }
    /* En-tête : grande photo sur toute la largeur, les deux autres côte à côte dessous. */
    .tete-photos.mosaique { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .mosaique figure:first-child { grid-column: 1 / -1; grid-row: auto; }
    .mosaique figure:not(:first-child) { aspect-ratio: 4 / 3; }
    .suite { flex-direction: column; }
    .suiv-l { align-self: flex-end; }
  }
</style>
