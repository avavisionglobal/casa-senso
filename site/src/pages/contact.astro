---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTete from '../components/PageTete.astro';
import fauteuil from '../assets/images/contact-fauteuil.jpg';
import { site } from '../data/site';
---
<Base
  title="Contact Casa Senso | Votre projet à Neuchâtel"
  description="Un projet d’aménagement ou de décoration à Neuchâtel ? Contactez Casa Senso pour imaginer un intérieur adapté à vos envies, à vos besoins et à votre budget."
>
  <PageTete titre="Me contacter" sous="Parlons de votre <em>projet</em>." />

  <div class="contact-grid conteneur">
    <div class="coord" data-anim="up">
      <p class="mention">Casa Senso</p>
      <p class="strong">
        <span class="person">{site.person}</span><br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </p>
      <p class="addr">{site.cityContact}<br />{site.country}</p>
      <Image src={fauteuil} alt="Contact Casa Senso Neuchâtel" widths={[416, 598]} sizes="(max-width: 999px) 100vw, 416px" class="fauteuil" />
    </div>

    <div class="form-col" data-anim="up">
      <p class="form-sub">Remplissez le formulaire ci-dessous, je vous recontacte rapidement.</p>
      <form class="form" method="post" action="/api/contact" novalidate>
        <div class="field half">
          <label for="prenom">Prénom *</label>
          <input id="prenom" name="prenom" type="text" autocomplete="given-name" required />
        </div>
        <div class="field half">
          <label for="nom">Nom *</label>
          <input id="nom" name="nom" type="text" autocomplete="family-name" required />
        </div>
        <div class="field">
          <label for="email">E-mail *</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="sujet">Sujet *</label>
          <input id="sujet" name="sujet" type="text" required />
        </div>
        <div class="field">
          <label for="message">Message *</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="site-web">Site web</label>
          <input id="site-web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="send" type="submit">Envoyer</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.form');
  const status = document.querySelector<HTMLElement>('.status');
  const say = (msg: string, kind: 'ok' | 'err') => { if (status) { status.textContent = msg; status.dataset.kind = kind; } };
  const params = new URLSearchParams(location.search);
  if (params.get('envoye') === '1') say('Merci, votre message a bien été envoyé.', 'ok');
  if (params.get('envoye') === '0') say('Le message n’a pas pu être envoyé. Écrivez-moi à studio@casa-senso.ch.', 'err');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    let firstInvalid: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((f) => {
      const bad = !f.value.trim() || (f.type === 'email' && !f.checkValidity());
      f.toggleAttribute('aria-invalid', bad);
      if (bad && !firstInvalid) firstInvalid = f;
    });
    if (firstInvalid) { (firstInvalid as HTMLElement).focus(); say('Merci de remplir les champs marqués d’un astérisque.', 'err'); return; }
    const btn = form.querySelector<HTMLButtonElement>('.send');
    if (btn) btn.disabled = true;
    say('Envoi en cours…', 'ok');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      say('Merci, votre message a bien été envoyé.', 'ok');
      window.dispatchEvent(new CustomEvent('cs:lead', { detail: { form: 'contact' } }));
    } catch {
      say('Le message n’a pas pu être envoyé. Écrivez-moi à studio@casa-senso.ch.', 'err');
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>

<style>
  .contact-grid { padding-bottom: 120px; display: grid; grid-template-columns: 5fr 7fr; gap: 80px; align-items: start; }
  .contact-grid > * { min-width: 0; }
  .coord { background: var(--card); border-radius: calc(var(--radius) + 8px); padding: 36px 36px 28px; }
  .strong { margin-top: 14px; font-family: var(--serif); font-size: 24px; line-height: 1.5; }
  .strong a { transition: color .3s var(--ease); }
  .strong a:hover { color: var(--accent); }
  .addr { margin-top: 14px; font-size: 16px; line-height: 1.6; color: var(--muted); }
  .coord :global(.fauteuil) { margin-top: 24px; width: 100%; aspect-ratio: 416 / 349; height: auto; object-fit: contain; mix-blend-mode: multiply; }

  .form-sub { font-family: var(--serif); font-size: 26px; line-height: 1.4; }
  .form { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; row-gap: 26px; }
  .field { grid-column: 1 / -1; display: flex; flex-direction: column; }
  .field.half { grid-column: auto; }
  label { font-weight: 500; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  input, textarea {
    border: 0; border-bottom: 1px solid var(--ink); border-radius: 0; background: transparent;
    height: 48px; padding: 10px 0 8px; font-size: 17px; font-family: var(--sans); outline: none;
    transition: border-color .3s var(--ease);
  }
  textarea { height: 120px; resize: none; }
  input:focus-visible, textarea:focus-visible { border-bottom: 2px solid var(--accent); }
  [aria-invalid] { border-bottom-color: #b3261e; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .send {
    grid-column: 1 / -1; justify-self: start; height: 52px; padding: 0 34px; margin-top: 6px;
    border: 0; border-radius: 999px; background: var(--accent); color: #fff;
    font-family: var(--sans); font-weight: 500; font-size: 16px; cursor: pointer; transition: background-color .35s var(--ease), transform .45s var(--ease);
  }
  .send:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .send:disabled { opacity: .6; cursor: progress; }
  .status { grid-column: 1 / -1; font-size: 15px; }
  .status:empty { display: none; }
  .status[data-kind='err'] { color: #b3261e; }

  @media (max-width: 999px) {
    .contact-grid { grid-template-columns: 1fr; gap: 40px; padding-bottom: 70px; }
    .coord { padding: 26px 22px 20px; }
    .strong { font-size: 20px; }
    .form-sub { font-size: 22px; }
    .form { margin-top: 26px; grid-template-columns: 1fr; }
    .field.half { grid-column: 1 / -1; }
    .send { width: 100%; }
  }
</style>
