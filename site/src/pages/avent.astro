---
// Calendrier de l'Avent 2026 · option A « La maison aux volets » (maquette du 18.11.2026 dans
// proofs/avent-2026/a-maison.html), choisie par Laetitia le 19.11.2026. Mise au propre le 22.11.2026 :
// intégrée au site (en-tête et pied de page), sans barre de démo ni photos d'exemple, textes à la
// première personne. Contenu des 24 jours : src/data/avent.ts.
// Aperçu d'une date : /avent?apercu=9 (simule le 9 décembre). Lien direct vers un jour : /avent#jour-9.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { jours, ANNEE, INSTAGRAM } from '../data/avent';
import batisse from '../assets/images/traits/batisse-creme.png';

// Jour jusqu'auquel le contenu est publié (heure de Zurich au moment du build).
const ymd = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Zurich', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const [y, m, d] = ymd.split('-').map(Number);
const jusqua = import.meta.env.AVENT_JUSQUA ? Number(import.meta.env.AVENT_JUSQUA)
  : y > ANNEE || (y === ANNEE && m === 12 && d > 24) ? 24 : y === ANNEE && m === 12 ? d : 0;

const data = await Promise.all(jours.map(async (j) => {
  if (j.n > jusqua) return { n: j.n };
  const grand = j.image ? (await getImage({ src: j.image, width: 1080, format: 'webp' })).src : undefined;
  const petit = j.image ? (await getImage({ src: j.image, width: 360, format: 'webp' })).src : undefined;
  return { n: j.n, titre: j.titre, texte: j.texte, post: j.post, grand, petit };
}));
const batisseSrc = (await getImage({ src: batisse, width: 900, format: 'webp' })).src;
const config = { annee: ANNEE, insta: INSTAGRAM, batisse: batisseSrc, jours: data };
---
<Base
  title="Calendrier de l'Avent | Casa Senso, décoration d'intérieur à Neuchâtel"
  description="Du 1er au 24 décembre, une planche de décoration chaque matin : ouvrez les fenêtres de la maison Casa Senso et préparez votre intérieur pour les fêtes."
  intro={false}
>
  <div class="avent">
    <canvas id="ciel" aria-hidden="true"></canvas>
    <div class="filet" aria-hidden="true"></div>

    <section class="intro-avent">
      <p class="mention">Calendrier de l’Avent · {ANNEE}</p>
      <h1>Vingt-quatre <em>fenêtres</em> sur les fêtes</h1>
      <p>Chaque matin, du 1er au 24 décembre, j’ouvre une planche de décoration sur Instagram. Ici, la maison garde la lumière allumée aux fenêtres déjà ouvertes.</p>
      <div class="etat">
        <p class="compte" data-compte></p>
        <div class="jauge" data-progress aria-hidden="true"><span></span></div>
        <div class="av-rattrapage" data-rattrapage></div>
      </div>
    </section>

    <div class="scene">
      <div class="maison">
        <div class="toit">
          <svg id="toit" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <pattern id="tuiles" width="34" height="16" patternUnits="userSpaceOnUse">
                <rect width="34" height="16" fill="#2B2724"/><path d="M0 15.5 H34 M17 0 V8 M0 8 H34" stroke="#1E1A17" stroke-width="1.2" opacity=".7"/>
              </pattern>
              <clipPath id="clip-toit"><polygon points="0,300 500,18 1000,300"/></clipPath>
            </defs>
            <rect x="703" y="34" width="56" height="130" fill="#3A332D" stroke="#1E1A17" stroke-width="3"/>
            <path d="M703 58 H759 M703 82 H759 M703 106 H759 M703 130 H759 M731 34 V58 M717 58 V82 M745 58 V82 M731 82 V106 M717 106 V130 M745 106 V130" stroke="#1E1A17" stroke-width="1.2" opacity=".6"/>
            <rect x="695" y="26" width="72" height="12" fill="#2B2724" stroke="#1E1A17" stroke-width="2.5"/>
            <path d="M692 28 C700 12 760 12 770 28 C772 32 690 32 692 28Z" fill="#FBF8F2"/>
            <polygon points="0,300 500,18 1000,300" fill="url(#tuiles)" stroke="#1E1A17" stroke-width="3"/>
            <polygon points="44,300 500,46 956,300" fill="#ECE3D2" stroke="#1E1A17" stroke-width="2.5"/>
            <g clip-path="url(#clip-toit)" opacity=".16" stroke="#1E1A17" stroke-width="1">
              <path d="M130 300 L500 92 L870 300"/><path d="M500 92 V300" stroke-dasharray="3 7"/>
            </g>
            <g id="consoles"></g>
            <path d="M-8,303 L500,8 L1008,303 L994,308 C984,296 976,300 966,304 L500,34 L34,304 C24,298 18,296 6,308 Z" fill="#FBF8F2"/>
            <g id="glacons" fill="#FBF8F2" opacity=".92"></g>
          </svg>
          <svg class="etoile-faite" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2 L24.5 15.5 L38 20 L24.5 24.5 L20 38 L15.5 24.5 L2 20 L15.5 15.5 Z" fill="#F4C97A"/></svg>
          <div id="pignon"></div>
          <div class="guirlande" aria-hidden="true"></div>
        </div>
        <div class="facade" id="facade" role="list" aria-label="Les 24 jours du calendrier">
          <span class="gouttiere" aria-hidden="true"></span>
        </div>
      </div>

      <div class="sol" aria-hidden="true">
        <svg class="neige-sol" viewBox="0 0 1000 96" preserveAspectRatio="none">
          <path d="M0 40 C120 14 300 8 500 10 C700 8 880 14 1000 40 V96 H0 Z" fill="#FBF8F2"/>
          <path d="M0 52 C200 34 360 30 500 30 C680 30 820 40 1000 56" fill="none" stroke="#E4DDD0" stroke-width="2"/>
          <g fill="#DCD3C4">
            <ellipse cx="492" cy="34" rx="5" ry="2.4"/><ellipse cx="510" cy="42" rx="5" ry="2.4"/><ellipse cx="488" cy="50" rx="5.5" ry="2.6"/><ellipse cx="506" cy="59" rx="5.5" ry="2.6"/>
            <ellipse cx="480" cy="68" rx="6" ry="2.8"/><ellipse cx="498" cy="78" rx="6" ry="2.8"/><ellipse cx="468" cy="87" rx="6.5" ry="3"/>
          </g>
        </svg>
        <svg class="muret" viewBox="0 0 180 34" preserveAspectRatio="none">
          <path d="M0 8 H180 V34 H0 Z" fill="#B9AA8F" stroke="#1E1A17" stroke-width="2"/>
          <path d="M0 20 H180 M30 8 V20 M74 8 V20 M120 8 V20 M160 8 V20 M12 20 V34 M54 20 V34 M98 20 V34 M142 20 V34" stroke="#1E1A17" stroke-width="1.4" opacity=".7"/>
          <path d="M-2 9 C20 0 60 2 90 3 C130 2 160 0 182 9 Z" fill="#FBF8F2"/>
        </svg>
        <svg class="sapin g" viewBox="0 0 90 120"><path d="M45 4 L80 60 H62 L86 100 H4 L28 60 H10 Z" fill="#3B4433" stroke="#1E1A17" stroke-width="2"/><path d="M45 4 L62 32 H28 Z M22 70 H68 L60 60 H30 Z" fill="#FBF8F2"/><rect x="39" y="100" width="12" height="18" fill="#2A2622"/>
          <g fill="#F4C97A"><circle cx="36" cy="46" r="2.6"/><circle cx="56" cy="52" r="2.6"/><circle cx="30" cy="84" r="2.6"/><circle cx="48" cy="80" r="2.6"/><circle cx="66" cy="88" r="2.6"/></g></svg>
        <svg class="sapin d" viewBox="0 0 90 120"><path d="M45 4 L80 60 H62 L86 100 H4 L28 60 H10 Z" fill="#4A5440" stroke="#1E1A17" stroke-width="2"/><path d="M45 4 L62 32 H28 Z" fill="#FBF8F2"/><rect x="39" y="100" width="12" height="18" fill="#2A2622"/>
          <g fill="#F4C97A"><circle cx="40" cy="48" r="2.6"/><circle cx="58" cy="76" r="2.6"/><circle cx="26" cy="88" r="2.6"/></g></svg>
      </div>
    </div>

    <div class="legende">
      <span><i class="l1"></i>Volets fermés : à venir</span>
      <span><i class="l2"></i><span>Lumière qui filtre : <b data-nouveaux></b></span></span>
      <span><i class="l3"></i>Volets ouverts : déjà vue</span>
    </div>

    <section class="jour" id="planche-du-jour" aria-labelledby="jour-titre">
      <figure class="jour__img">
        <img id="jour-img" src={batisseSrc} alt="" width="900" height="1125" />
        <span class="jour__vide" aria-hidden="true"><span class="jour__vide-n"></span><span class="jour__vide-m">décembre</span></span>
        <span class="jour__voile" aria-hidden="true"><i class="g"></i><i class="d"></i></span>
      </figure>
      <div class="jour__texte">
        <p class="mention" id="jour-quand">Ouverture le 1er décembre</p>
        <h2 id="jour-titre">La première fenêtre s’ouvre bientôt</h2>
        <p id="jour-desc">Chaque matin, une planche de décoration pour préparer la maison aux fêtes. Suivez-moi sur Instagram pour ne pas manquer la première.</p>
        <a class="av-btn av-btn--plein" id="jour-btn" href={INSTAGRAM} target="_blank" rel="noopener">Suivre @casa_senso.ch</a>
      </div>
    </section>

    <section class="comment">
      <h2>Comment ça <em>marche</em></h2>
      <ol class="etapes">
        <li><b>Chaque matin, une planche</b>Du 1er au 24 décembre, je dévoile sur Instagram une ambiance ou une idée de décoration pour les fêtes.</li>
        <li><b>La fenêtre du jour s’allume</b>Le lien de mon profil mène ici. Les volets laissent filtrer la lumière tant que vous n’avez pas regardé.</li>
        <li><b>Rien ne se perd</b>Les fenêtres déjà ouvertes le restent jusqu’à Noël : vous pouvez revoir chaque planche quand vous voulez.</li>
      </ol>
    </section>

    <section class="suite">
      <h2>Une ambiance vous donne <em>envie</em> ?</h2>
      <p>Chaque planche part d’une vraie façon d’habiter. Si vous voulez la même chez vous, parlons de votre projet.</p>
      <div class="boutons">
        <a class="av-btn av-btn--plein" href="/contact#formulaire">Prendre rendez-vous</a>
        <a class="av-btn av-btn--ligne" href={INSTAGRAM} target="_blank" rel="noopener">Suivre @casa_senso.ch</a>
      </div>
    </section>
  </div>

  <script type="application/json" id="avent-config" set:html={JSON.stringify(config)} />
</Base>

<script>
  /* Calendrier de l'Avent : une fenêtre s'ouvre chaque jour du 1er au 24 décembre (date du visiteur).
     Les fenêtres déjà regardées sont mémorisées dans son navigateur (nouvelle / déjà vue).
     Repris de proofs/avent-2026/shared.js et a-maison.html (18.11.2026), sans la barre de démo. */
  type Jour = { n: number; titre?: string; texte?: string; post?: string; grand?: string; petit?: string };
  const CFG = JSON.parse(document.getElementById('avent-config')!.textContent!) as { annee: number; insta: string; batisse: string; jours: Jour[] };
  const AN = CFG.annee, INSTA = CFG.insta;
  const typo = (s: string) => s.replace(/ ([:;!?»])/g, ' $1').replace(/« /g, '« ');
  const DAYS = CFG.jours.map((j) => ({
    ...j,
    date: new Date(AN, 11, j.n),
    nom: j.titre || 'La planche du ' + (j.n === 1 ? '1er' : j.n) + ' décembre',
    desc: j.texte || 'Retrouvez la planche de ce jour sur mon Instagram.',
    lien: j.post || INSTA,
  }));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmtLong = (d: Date) => d.toLocaleDateString('fr-CH', { weekday: 'long', day: 'numeric', month: 'long' });

  function h(tag: string, attrs?: Record<string, any> | null, ...kids: any[]) {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs || {})) {
      if (v === true) el.setAttribute(k, '');
      else if (v !== false && v != null) el.setAttribute(k, String(v));
    }
    for (const c of kids.flat()) if (c != null) el.append(c);
    return el;
  }

  /* ---------- date ---------- */
  function realDay() {
    const now = new Date(), y = now.getFullYear();
    if (y > AN || (y === AN && now.getMonth() === 11 && now.getDate() > 24)) return 24;
    if (y === AN && now.getMonth() === 11) return now.getDate();
    return 0;
  }
  const apercu = parseInt(new URLSearchParams(location.search).get('apercu') || '', 10);
  const today = Number.isFinite(apercu) ? Math.max(0, Math.min(24, apercu)) : realDay();
  const joursAvantOuverture = () => Math.max(0, Math.ceil((+new Date(AN, 11, 1) - Date.now()) / 864e5));

  const KEY = 'casa-avent-' + AN + '-vu';
  let seen: Set<number>;
  try { seen = new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch (e) { seen = new Set(); }
  const saveSeen = () => { try { localStorage.setItem(KEY, JSON.stringify([...seen])); } catch (e) {} };
  const state = (n: number) => (n > today ? 'ferme' : seen.has(n) ? 'vu' : 'nouveau');
  const nonVus = () => DAYS.filter((d) => state(d.n) === 'nouveau').map((d) => d.n);

  /* ---------- fenêtre de lecture ---------- */
  const el = {
    img: h('img', { alt: '' }) as HTMLImageElement,
    vide: h('span', { class: 'av-modal__vide', 'aria-hidden': 'true' }),
    num: h('span', { class: 'av-modal__num', 'aria-hidden': 'true' }),
    deco: h('span', { class: 'av-modal__deco', 'aria-hidden': 'true' }, h('i', { class: 'g' }), h('i', { class: 'd' })),
    jour: h('p', { class: 'av-modal__jour' }),
    titre: h('h2', { id: 'av-titre', class: 'av-modal__titre' }),
    desc: h('p', { class: 'av-modal__desc' }),
    post: h('a', { class: 'av-btn av-btn--plein', target: '_blank', rel: 'noopener' }, 'Voir sur Instagram') as HTMLAnchorElement,
    prev: h('button', { 'data-prev': true }, '‹ Jour précédent') as HTMLButtonElement,
    next: h('button', { 'data-next': true }, 'Jour suivant ›') as HTMLButtonElement,
    fermer: h('button', { class: 'av-modal__fermer', 'data-close': true, 'aria-label': 'Fermer' }, '×') as HTMLButtonElement,
    frise: h('div', { class: 'av-modal__frise' }),
  };
  const fig = h('figure', { class: 'av-modal__img' }, el.vide, el.img, el.deco, el.num);
  const pastilles = DAYS.map((d) => {
    const b = h('button', { class: 'av-pastille', 'data-goto': d.n }, String(d.n)) as HTMLButtonElement;
    el.frise.append(b);
    return b;
  });
  const modal = h('div', { class: 'av-modal', hidden: true },
    h('div', { class: 'av-modal__voile', 'data-close': true }),
    h('article', { class: 'av-modal__carte', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'av-titre' },
      el.fermer, fig,
      h('div', { class: 'av-modal__texte' },
        el.jour, el.titre, el.desc,
        h('div', { class: 'av-modal__actions' }, el.post, h('button', { class: 'av-btn av-btn--ligne', 'data-share': true }, 'Partager ce jour')),
        h('a', { class: 'av-modal__rdv', href: '/contact#formulaire' }, 'Cette ambiance chez vous ? Parlons de votre projet →'),
        h('nav', { class: 'av-modal__nav', 'aria-label': 'Autres jours' }, el.prev, el.next),
        h('p', { class: 'av-modal__frise-titre' }, 'Toutes les planches'),
        el.frise)));
  document.body.appendChild(modal);
  let current = 0, lastFocus: Element | null = null, suite = false;

  function cibleSuivante() {
    if (suite) { const k = nonVus(); if (k.length) return k[0]; }
    return current < today ? current + 1 : 0;
  }
  function fill(n: number) {
    const d = DAYS[n - 1];
    const premiere = !seen.has(n);
    current = n;
    fig.classList.toggle('sans-image', !d.grand);
    if (d.grand) { el.img.src = d.grand; el.img.alt = 'Planche du ' + n + ' décembre : ' + d.nom; }
    else { el.img.removeAttribute('src'); el.img.alt = ''; }
    el.vide.replaceChildren(h('b', null, String(n)), h('span', null, 'décembre'));
    el.num.textContent = String(n).padStart(2, '0');
    el.jour.textContent = 'Jour ' + n + ' · ' + fmtLong(d.date);
    el.titre.textContent = typo(d.nom);
    el.desc.textContent = typo(d.desc);
    el.post.href = d.lien;
    el.post.textContent = d.post ? 'Voir le post sur Instagram' : 'Voir sur Instagram';
    if (premiere) { seen.add(n); saveSeen(); }
    modal.removeAttribute('data-premiere'); void modal.offsetWidth;
    if (premiere && !reduced) modal.setAttribute('data-premiere', '');
    el.prev.disabled = n <= 1;
    const s = cibleSuivante();
    el.next.disabled = !s;
    el.next.textContent = suite && nonVus().length ? 'Planche suivante pas encore vue ›'
      : s ? 'Jour suivant ›' : n < 24 ? 'La suite demain matin' : 'C’était la dernière';
    pastilles.forEach((b, i) => {
      const k = i + 1, st = state(k);
      b.className = 'av-pastille ' + st + (k === n ? ' courant' : '');
      b.disabled = st === 'ferme';
      b.setAttribute('aria-label', 'Jour ' + k + (st === 'ferme' ? ', pas encore ouvert' : st === 'nouveau' ? ', pas encore vu' : ''));
      if (k === n) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
    });
    history.replaceState(null, '', '#jour-' + n);
    refresh();
  }
  function open(n: number, opts?: { suite?: boolean }) {
    if (n > today) return locked(n);
    suite = !!(opts && opts.suite);
    if (modal.hasAttribute('hidden')) lastFocus = document.activeElement;
    fill(n);
    modal.removeAttribute('hidden');
    requestAnimationFrame(() => modal.classList.add('is-open'));
    document.documentElement.classList.add('av-lock');
    el.fermer.focus();
  }
  function close() {
    modal.classList.remove('is-open');
    document.documentElement.classList.remove('av-lock');
    setTimeout(() => modal.setAttribute('hidden', ''), 350);
    history.replaceState(null, '', location.pathname + location.search);
    suite = false;
    (lastFocus as HTMLElement | null)?.focus?.({ preventScroll: true });
  }
  function step(k: number) {
    const n = k > 0 ? cibleSuivante() : current - 1;
    if (n >= 1 && n <= today) fill(n);
  }
  modal.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const g = t.closest<HTMLElement>('[data-goto]');
    if (t.closest('[data-close]')) close();
    else if (g) { suite = false; fill(+g.dataset.goto!); }
    else if (t.closest('[data-prev]')) step(-1);
    else if (t.closest('[data-next]')) step(1);
    else if (t.closest('[data-share]')) share(current);
  });
  document.addEventListener('keydown', (e) => {
    if (modal.hasAttribute('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
  let sx: number | null = null; // balayage sur téléphone
  modal.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  modal.addEventListener('touchend', (e) => {
    if (sx === null) return; const dx = e.changedTouches[0].clientX - sx; sx = null;
    if (dx > 60) step(-1); if (dx < -60) step(1);
  });
  async function share(n: number) {
    const url = location.origin + location.pathname + '#jour-' + n;
    try {
      if (navigator.share) await navigator.share({ title: 'Casa Senso · Calendrier de l’Avent, jour ' + n, url });
      else { await navigator.clipboard.writeText(url); toast('Lien du jour ' + n + ' copié'); }
    } catch (e) {}
  }

  /* ---------- message pour une case fermée ---------- */
  const tst = h('div', { class: 'av-toast', role: 'status' });
  document.body.appendChild(tst);
  let tt: number;
  function toast(msg: string) {
    tst.textContent = typo(msg); tst.classList.add('is-on');
    clearTimeout(tt); tt = window.setTimeout(() => tst.classList.remove('is-on'), 2800);
  }
  function locked(n: number) {
    const diff = n - today;
    toast(today === 0 ? 'Patience : le calendrier s’ouvre le 1er décembre.'
      : diff === 1 ? 'Patience : cette fenêtre s’ouvre demain matin.'
      : 'Patience : cette fenêtre s’ouvre le ' + n + ' décembre, dans ' + diff + ' jours.');
  }

  /* ---------- la maison ---------- */
  const SVGNS = 'http://www.w3.org/2000/svg';
  const s = (tag: string, attrs: Record<string, any>) => { const e = document.createElementNS(SVGNS, tag); for (const k in attrs) e.setAttribute(k, String(attrs[k])); return e; };
  const consoles = document.getElementById('consoles')!, glacons = document.getElementById('glacons')!;
  [[44, 300, 500, 46], [956, 300, 500, 46]].forEach(([x0, y0, x1, y1]) => {
    const ang = Math.atan2(y1 - y0, x1 - x0) * 180 / Math.PI;
    [.16, .38, .6, .8].forEach((t) => {
      const x = x0 + (x1 - x0) * t, y = y0 + (y1 - y0) * t;
      consoles.append(s('rect', { x: x - 9, y: y - 2, width: 18, height: 22, fill: '#6B5A45', stroke: '#1E1A17', 'stroke-width': 2, transform: `rotate(${x0 < 500 ? ang : ang - 180} ${x} ${y})` }));
    });
  });
  [[6, 306, 500, 34], [994, 306, 500, 34]].forEach(([x0, y0, x1, y1]) => {
    for (let t = .04; t < .9; t += .045) {
      const x = x0 + (x1 - x0) * t, y = y0 + (y1 - y0) * t, l = 8 + ((t * 97) % 1) * 18;
      glacons.append(s('path', { d: `M${x - 3.5} ${y - 1} L${x + 3.5} ${y - 1} L${x} ${y + l} Z` }));
    }
  });

  const facade = document.getElementById('facade')!;
  const pignon = document.getElementById('pignon')!;
  const guirlande = document.querySelector('.guirlande')!;
  for (let i = 0; i < 16; i++) guirlande.append(h('span', { style: '--i:' + i }));

  const btns: Record<number, HTMLButtonElement> = {};
  function fenetre(d: (typeof DAYS)[number], cls?: string) {
    const b = h('button', { class: 'fen ' + (cls || ''), 'data-n': d.n, role: 'listitem', type: 'button' },
      h('span', { class: 'fen__linteau' }),
      h('span', { class: 'fen__cadre' },
        h('span', { class: 'fen__lueur' }),
        h('span', { class: 'fen__vitre' + (d.petit ? '' : ' vide'), style: d.petit ? 'background-image:url(' + d.petit + ')' : null }),
        h('span', { class: 'fen__croix' }),
        h('span', { class: 'fen__tag' }, String(d.n))),
      h('span', { class: 'fen__volet g' }), h('span', { class: 'fen__volet d' }),
      h('span', { class: 'fen__num' }, String(d.n)),
      h('span', { class: 'fen__appui' }),
      h('span', { class: 'fen__jardin' })) as HTMLButtonElement;
    b.addEventListener('click', () => clic(d.n));
    btns[d.n] = b;
    return b;
  }
  pignon.append(fenetre(DAYS[0], 'rond'));
  DAYS.slice(1, 23).forEach((d) => facade.append(fenetre(d)));
  const porte = fenetre(DAYS[23], 'porte');
  porte.append(h('span', { class: 'porte__arc' }), h('span', { class: 'porte__cle' }),
    h('span', { class: 'couronne' }, h('i'), h('i'), h('i')), h('span', { class: 'poignee' }),
    h('span', { class: 'lanterne' }), h('span', { class: 'marches' }));
  facade.append(porte);

  /* ouvrir une fenêtre : volets, poussière dorée, vague dans la guirlande, puis la planche */
  function animerOuverture(n: number) {
    const b = btns[n];
    b.classList.remove('nouveau'); b.classList.add('vu');
    const r = b.getBoundingClientRect();
    eclats(r.left + r.width / 2, r.top + r.height / 2);
    guirlande.classList.remove('vague'); void (guirlande as HTMLElement).offsetWidth; guirlande.classList.add('vague');
  }
  function clic(n: number, opts?: { suite?: boolean }) {
    const st = state(n), b = btns[n];
    if (st === 'ferme') { b.classList.remove('secoue'); void b.offsetWidth; b.classList.add('secoue'); return open(n); }
    if (st === 'nouveau') { animerOuverture(n); setTimeout(() => open(n, opts), reduced ? 0 : 900); return; }
    open(n, opts);
  }
  /* depuis un lien #jour-N ou « à la suite » : la fenêtre vient à l'écran avant de s'ouvrir */
  function ouvrir(n: number, opts?: { suite?: boolean }) {
    const b = btns[n]; if (!b) return;
    if (state(n) !== 'nouveau') return open(n, opts);
    const r = b.getBoundingClientRect();
    const visible = r.top > 100 && r.bottom < innerHeight - 60;
    if (!visible) b.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
    setTimeout(() => clic(n, opts), visible || reduced ? 0 : 700);
  }

  /* ---------- la planche du jour ---------- */
  const J = {
    sec: document.getElementById('planche-du-jour')!, img: document.getElementById('jour-img') as HTMLImageElement,
    videN: document.querySelector('.jour__vide-n')!, quand: document.getElementById('jour-quand')!,
    titre: document.getElementById('jour-titre')!, desc: document.getElementById('jour-desc')!, btn: document.getElementById('jour-btn') as HTMLAnchorElement,
  };
  function renderJour() {
    const t = today;
    J.sec.classList.toggle('avant', t === 0);
    if (t === 0) return; // texte « avant le 1er décembre » déjà dans la page
    const d = DAYS[t - 1], st = state(t);
    J.btn.href = '#jour-' + t; J.btn.removeAttribute('target'); J.btn.removeAttribute('rel');
    J.sec.classList.toggle('sans-image', !d.grand);
    if (d.grand) { if (J.img.getAttribute('src') !== d.grand) J.img.src = d.grand; }
    J.img.alt = d.grand && st === 'vu' ? 'Planche du ' + t + ' décembre : ' + d.nom : '';
    J.videN.textContent = String(t);
    J.quand.textContent = 'Aujourd’hui · ' + fmtLong(d.date);
    J.sec.classList.toggle('ouvert', st === 'vu');
    if (st === 'nouveau') {
      J.titre.textContent = 'La planche du jour vous attend';
      J.desc.textContent = 'Les volets sont encore fermés. Ouvrez-les pour découvrir l’ambiance du ' + (t === 1 ? '1er' : t) + ' décembre.';
      J.btn.textContent = 'Ouvrir les volets';
    } else {
      J.titre.textContent = typo(d.nom); J.desc.textContent = typo(d.desc); J.btn.textContent = 'Revoir la planche';
    }
  }
  J.btn.addEventListener('click', (e) => {
    const t = today; if (t === 0) return;
    e.preventDefault();
    if (state(t) === 'nouveau') {
      J.sec.classList.add('ouvert');
      btns[t].classList.remove('nouveau'); btns[t].classList.add('vu');
      setTimeout(() => open(t), reduced ? 0 : 1100);
    } else open(t);
  });

  /* ---------- textes vivants ---------- */
  function rattrapage(box: HTMLElement) {
    const k = nonVus();
    box.classList.toggle('a-jour', !k.length);
    if (!k.length) {
      box.replaceChildren(h('span', {}, typo(today === 0 ? 'Rendez-vous le 1er décembre pour la première planche.'
        : today === 24 ? 'Vous avez tout vu. Joyeuses fêtes !' : 'Vous êtes à jour. La prochaine planche arrive demain matin.')));
      return;
    }
    const b = h('button', { class: 'av-rattrapage__btn', type: 'button' }, k.length === 1 ? 'L’ouvrir' : 'Les ouvrir à la suite');
    b.addEventListener('click', () => ouvrir(k[0], { suite: true }));
    box.replaceChildren(
      h('span', { class: 'av-rattrapage__pt', 'aria-hidden': 'true' }),
      h('span', {}, k.length === 1 ? 'Une planche vous attend' : k.length + ' planches vous attendent'), b);
  }
  function refresh() {
    document.querySelectorAll<HTMLElement>('[data-compte]').forEach((x) => {
      const j = joursAvantOuverture();
      x.textContent = today === 0 ? (j > 1 ? 'Première planche le 1er décembre · dans ' + j + ' jours' : 'Première planche le 1er décembre')
        : today === 24 ? 'Les 24 planches sont ouvertes'
        : today + (today > 1 ? ' planches ouvertes' : ' planche ouverte') + ' sur 24 · la suivante demain matin';
    });
    document.querySelectorAll<HTMLElement>('[data-nouveaux]').forEach((x) => {
      const k = nonVus().length;
      x.textContent = today === 0 ? 'la planche du jour' : k ? (k === 1 ? '1 planche pas encore vue' : k + ' planches pas encore vues') : 'vous êtes à jour';
    });
    document.querySelectorAll<HTMLElement>('[data-rattrapage]').forEach(rattrapage);
    document.querySelectorAll<HTMLElement>('[data-progress]').forEach((x) => x.style.setProperty('--p', String(today / 24)));
    renderJour();
    for (const d of DAYS) {
      const b = btns[d.n], st = state(d.n);
      b.classList.remove('ferme', 'nouveau', 'vu');
      b.classList.add(st);
      b.classList.toggle('est-aujourdhui', d.n === today);
      b.setAttribute('aria-label', 'Jour ' + d.n + (st === 'ferme' ? ', s’ouvre le ' + d.n + ' décembre' : ' : ' + d.nom + (st === 'nouveau' ? ', pas encore vue' : '')));
    }
    document.querySelector('.avent')!.classList.toggle('fete', today === 24 && !nonVus().length);
  }

  refresh();
  const m = location.hash.match(/^#jour-(\d+)$/);
  if (m) setTimeout(() => ouvrir(+m[1]), 500);

  /* ---------- ciel : étoiles fixes, neige rare et lente, poussière dorée à l'ouverture ---------- */
  const c = document.getElementById('ciel') as HTMLCanvasElement, x = c.getContext('2d')!;
  let W = 0, H = 0, R = 1;
  let flocons: { x: number; y: number; r: number; v: number; o: number; a: number }[] = [];
  let etoiles: { x: number; y: number; r: number; a: number }[] = [];
  let parts: { x: number; y: number; vx: number; vy: number; l: number; r: number }[] = [];
  function taille() {
    R = Math.min(2, devicePixelRatio || 1);
    W = c.width = innerWidth * R; H = c.height = innerHeight * R;
    const petit = innerWidth < 700;
    flocons = Array.from({ length: petit ? 16 : 30 }, () => ({ x: Math.random() * W, y: Math.random() * H, r: (Math.random() * 1.2 + .5) * R, v: Math.random() * .22 + .16, o: Math.random() * 7, a: Math.random() * .3 + .25 }));
    etoiles = Array.from({ length: petit ? 28 : 56 }, () => ({ x: Math.random() * W, y: Math.random() * H * .5, r: (Math.random() * .8 + .35) * R, a: Math.random() * .3 + .12 }));
    if (reduced) dessinerEtoiles();
  }
  function dessinerEtoiles() { x.clearRect(0, 0, W, H); for (const e of etoiles) { x.fillStyle = `rgba(251,248,242,${e.a})`; x.fillRect(e.x, e.y, e.r, e.r); } }
  taille(); addEventListener('resize', taille);
  function eclats(cx: number, cy: number) {
    if (reduced) return;
    for (let i = 0; i < 18; i++) {
      const a = Math.random() * Math.PI * 2, v = (Math.random() * 1.4 + .5) * R;
      parts.push({ x: cx * R, y: cy * R, vx: Math.cos(a) * v, vy: Math.sin(a) * v - .5 * R, l: 1, r: (Math.random() * 1.1 + .5) * R });
    }
  }
  function tick() {
    dessinerEtoiles();
    for (const f of flocons) {
      f.o += .004; f.y += f.v * R; f.x += Math.sin(f.o) * .12 * R;
      if (f.y > H) { f.y = -5; f.x = Math.random() * W; }
      x.fillStyle = `rgba(251,248,242,${f.a})`; x.beginPath(); x.arc(f.x, f.y, f.r, 0, 7); x.fill();
    }
    parts = parts.filter((p) => p.l > 0);
    for (const p of parts) {
      p.x += p.vx; p.y += p.vy; p.vy += .025 * R; p.vx *= .985; p.l -= .011;
      x.fillStyle = `rgba(233,205,140,${Math.max(0, p.l) * .9})`; x.beginPath(); x.arc(p.x, p.y, p.r, 0, 7); x.fill();
    }
    requestAnimationFrame(tick);
  }
  if (!reduced) tick();
</script>

<style is:global>
  /* ---------- calendrier de l'Avent : la nuit, la maison, ses volets ---------- */
