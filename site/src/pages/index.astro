---
// Accueil v2 (13.11.2026) : structure de sections inspirée de madah.fr (référence de Diego),
// DA du site Casa Senso inchangée. Ancienne version : proofs/index-reproduction-wix-2026-11-13.astro
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowButton from '../components/ArrowButton.astro';
import { site } from '../data/site';

import heroSalon from '../assets/images/accueil/hero-cannes-salon.jpg';
import heroSejour from '../assets/images/accueil/hero-cannes-sejour.jpg';
import heroCuisine from '../assets/images/accueil/hero-cannes-cuisine.jpg';
import heroChambre from '../assets/images/accueil/hero-cannes-chambre.jpg';
import cannesConsole from '../assets/images/accueil/cannes-console.jpg';
import cannesBain from '../assets/images/accueil/cannes-salle-de-bain.jpg';
import cannesCuisine from '../assets/images/accueil/cannes-cuisine.jpg';
import maisonSalon from '../assets/images/accueil/maison-salon.jpg';
import maisonSalle from '../assets/images/accueil/maison-salle-a-manger.jpg';
import maisonCanape from '../assets/images/accueil/maison-canape.jpg';
import avDressing from '../assets/images/avant-dressing.jpg';
import apDressing from '../assets/images/apres-dressing.jpg';
import avCheminee from '../assets/images/avant-cheminee.jpg';
import apCheminee from '../assets/images/apres-cheminee.jpg';
import igMiroirs from '../assets/images/accueil/insta-cannes-miroirs.jpg';
import igBouddhas from '../assets/images/accueil/insta-maison-bouddhas.jpg';
import igChambreCannes from '../assets/images/accueil/insta-cannes-chambre.jpg';
import igChambre from '../assets/images/accueil/insta-maison-chambre.jpg';
import igBuffet from '../assets/images/accueil/insta-maison-buffet.jpg';

const instagram = 'https://www.instagram.com/casa_senso.ch/';

const slides = [
  { src: heroSalon, alt: "Salon de l'appartement de Cannes aménagé et décoré par Casa Senso", lieu: 'Le salon' },
  { src: heroSejour, alt: "Séjour de l'appartement de Cannes, suspension Vertigo et fauteuils bouclette", lieu: 'Le séjour' },
  { src: heroCuisine, alt: "Cuisine de l'appartement de Cannes, îlot en marbre et miroirs en arche", lieu: 'La cuisine' },
  { src: heroChambre, alt: "Chambre de l'appartement de Cannes, mur vert et lit blanc", lieu: 'La chambre' },
];

const insta = [
  { src: igMiroirs, alt: "Salle de bains de Cannes, miroirs ronds dorés" },
  { src: igBouddhas, alt: 'Maison de famille, statues devant le mur de briques' },
  { src: igChambreCannes, alt: "Chambre de l'appartement de Cannes, bibliothèque blanche et tabouret" },
  { src: igChambre, alt: 'Maison de famille, chevet et bouquet de fleurs' },
  { src: igBuffet, alt: 'Maison de famille, buffet noir et mur de briques' },
];
---
<Base
  title="Casa Senso | Aménagement & décoration à Neuchâtel"
  description="Casa Senso imagine et aménage votre intérieur à Neuchâtel. Décoration, mobilier et accompagnement clé en main pour des espaces qui vous ressemblent."
>
  <!-- 1. Grand visuel : photos de Cannes en fondu, titre en bas à gauche -->
  <section class="hero" aria-label="Réalisations Casa Senso">
    <div class="slides">
      {slides.map((s, i) => (
        <figure class:list={['slide', { 'is-active': i === 0 }]} data-lieu={s.lieu}>
          <Image src={s.src} alt={s.alt} widths={[640, 1024, 1600, 2400, 2880]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
        </figure>
      ))}
    </div>
    <div class="hero-text">
      <h1>De l'idée à la réalisation</h1>
      <p>Le plaisir de choisir. La liberté de déléguer.</p>
    </div>
    <div class="hero-meta">
      <span class="hero-caption"><span class="hero-count">01 / 0{slides.length}</span> · L'appartement de Cannes · <span class="hero-lieu">{slides[0].lieu}</span></span>
      <button class="hero-pause" type="button" aria-label="Mettre le diaporama en pause" aria-pressed="false">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="ico-pause" d="M5 3v10M11 3v10" /><path class="ico-play" d="M5 3l8 5-8 5z" /></svg>
      </button>
    </div>
  </section>

  <!-- 2. Intro (textes du site actuel) -->
  <section class="intro" data-anim="fade">
    <h2>Des espaces pensés pour vous, jusque dans les moindres détails.</h2>
    <h3>Votre intérieur mérite de refléter votre personnalité, vos envies et votre façon de vivre.</h3>
    <p>De l'aménagement à la décoration, en passant par l'optimisation des espaces, je conçois et coordonne votre projet de A à Z.</p>
    <p>Sélection du mobilier, choix des matières, commandes et installation : chaque étape est pensée pour vous simplifier la vie.</p>
    <p class="strong">Décrivez-moi votre intérieur idéal, je me charge de l'imaginer pour vous et de lui donner vie.</p>
    <ArrowButton href="/agence" label="Découvrez la vision Casa Senso" class="intro-btn" />
  </section>

  <!-- 3. Réalisations en mosaïque : une ligne par projet -->
  <section class="projets" aria-labelledby="projets-titre">
    <div class="projets-head" data-anim="fade">
      <h2 id="projets-titre">Mes dernières <span>réalisations</span></h2>
      <a class="lien" href="/realisations">Toutes les réalisations</a>
    </div>

    <div class="rangee r-cannes" data-anim="fade">
      <a class="tuile" href="/realisations"><Image src={cannesConsole} alt="Console et affiches de Cannes dans l'entrée de l'appartement" widths={[400, 700, 1000]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
      <a class="tuile" href="/realisations"><Image src={cannesBain} alt="Salle de bains de l'appartement de Cannes, bois et carrelage noir" widths={[400, 700, 1000]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
      <a class="tuile large titre" href="/realisations">
        <Image src={cannesCuisine} alt="Cuisine de l'appartement de Cannes avec îlot et suspensions en rotin" widths={[600, 1000, 1400, 2000]} sizes="(max-width: 999px) 100vw, 46vw" />
        <span class="tuile-texte"><span class="tuile-nom">L'appartement de Cannes</span><span class="pill">Voir le projet</span></span>
      </a>
    </div>

    <div class="rangee r-maison" data-anim="fade">
      <a class="tuile large titre" href="/realisations">
        <Image src={maisonSalon} alt="Salon de la maison de famille, fauteuil et coussins dorés" widths={[600, 1000, 1400, 1800]} sizes="(max-width: 999px) 100vw, 46vw" />
        <span class="tuile-texte"><span class="tuile-nom">La maison de famille</span><span class="pill">Voir le projet</span></span>
      </a>
      <a class="tuile" href="/realisations"><Image src={maisonSalle} alt="Salle à manger de la maison de famille, chaises dorées" widths={[400, 700, 1200]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
      <a class="tuile" href="/realisations"><Image src={maisonCanape} alt="Canapé de la maison de famille, plaid et coussins" widths={[400, 700, 1200]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
    </div>

    <div class="rangee r-avap" data-anim="fade">
      <a class="tuile" href="/realisations"><span class="etiquette">Avant</span><Image src={avDressing} alt="Dressing avant l'intervention de Casa Senso" widths={[400, 760]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
      <a class="tuile" href="/realisations"><span class="etiquette">Après</span><Image src={apDressing} alt="Dressing après l'intervention de Casa Senso" widths={[400, 760]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
      <a class="tuile" href="/realisations"><span class="etiquette">Avant</span><Image src={avCheminee} alt="Coin cheminée avant l'intervention de Casa Senso" widths={[400, 760]} sizes="(max-width: 999px) 50vw, 23vw" /></a>
      <a class="tuile titre" href="/realisations"><span class="etiquette">Après</span>
        <Image src={apCheminee} alt="Coin cheminée après l'intervention de Casa Senso" widths={[400, 760]} sizes="(max-width: 999px) 50vw, 23vw" />
        <span class="tuile-texte"><span class="tuile-nom">Avant / Après</span><span class="pill">Voir les avant / après</span></span>
      </a>
    </div>
  </section>

  <!-- 4. Citation de Laetitia (ses mots, e-mail du 08.11.2026) -->
  <section class="citation" aria-label="Le mot de Laetitia">
    <blockquote data-anim="fade">
      <p>« Ce qui m'anime avec Casa Senso, ce n'est pas seulement de créer de beaux intérieurs clef en main. C'est de provoquer une émotion, de soulager les gens et de voir le bonheur dans leurs yeux lorsqu'ils découvrent le résultat. »</p>
      <footer>Laetitia Rein, fondatrice de Casa Senso</footer>
    </blockquote>
  </section>

  <!-- 5. Carte projet -->
  <section class="projet-cta">
    <div class="carte" data-anim="fade">
      <div>
        <h2>Vous avez un projet ?<br /><span>Parlons-en ensemble.</span></h2>
        <p>Une pièce à repenser, une maison à aménager ou des locaux à mettre en valeur : dites-moi en quelques lignes ce que vous imaginez, je vous recontacte rapidement.</p>
        <p class="devis">Demander un devis gratuit et sans engagement.</p>
      </div>
      <div class="carte-actions">
        <ArrowButton href={`mailto:${site.email}`} label="Prendre rendez-vous" />
        <a class="lien" href="/prestations">Découvrez mes prestations</a>
      </div>
    </div>
  </section>

  <!-- 6. Instagram -->
  <section class="insta" aria-labelledby="insta-titre">
    <div class="insta-head" data-anim="fade">
      <h2 id="insta-titre">Suivez mes projets <span>sur Instagram</span></h2>
      <a class="lien" href={instagram} target="_blank" rel="noopener">@casa_senso.ch</a>
    </div>
    <div class="insta-grille" data-anim="fade">
      {insta.map((g) => (
        <a href={instagram} target="_blank" rel="noopener" class="insta-tuile" aria-label={`${g.alt} (Instagram)`}>
          <Image src={g.src} alt="" widths={[300, 500, 700]} sizes="(max-width: 999px) 50vw, 19vw" />
        </a>
      ))}
    </div>
    <div class="insta-cta" data-anim="fade"><ArrowButton href={instagram} label="Suivez-moi" /></div>
  </section>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const slides = hero ? [...hero.querySelectorAll<HTMLElement>('.slide')] : [];
  const count = hero?.querySelector('.hero-count');
  const lieu = hero?.querySelector('.hero-lieu');
  const btn = hero?.querySelector<HTMLButtonElement>('.hero-pause');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = 0;
  let timer: number | undefined;
  let paused = reduced;

  const show = (n: number) => {
    slides[i].classList.remove('is-active');
    i = (n + slides.length) % slides.length;
    slides[i].classList.add('is-active');
    if (count) count.textContent = `0${i + 1} / 0${slides.length}`;
    if (lieu) lieu.textContent = slides[i].dataset.lieu ?? '';
  };
  const play = () => { clearInterval(timer); if (!paused && slides.length > 1) timer = window.setInterval(() => show(i + 1), 6000); };
  const setPaused = (p: boolean) => {
    paused = p;
    hero?.classList.toggle('is-paused', p);
    btn?.setAttribute('aria-pressed', String(p));
    btn?.setAttribute('aria-label', p ? 'Relancer le diaporama' : 'Mettre le diaporama en pause');
    play();
  };
  btn?.addEventListener('click', () => setPaused(!paused));
  document.addEventListener('visibilitychange', () => { if (document.hidden) clearInterval(timer); else play(); });
  setPaused(paused);
</script>

<style>
  /* ---------- 1. Grand visuel ---------- */
  .hero { position: relative; height: calc(100svh - 74px); min-height: 600px; max-height: 920px; overflow: hidden; background: var(--grey); }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.4s ease; }
  .slide.is-active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .slide :global(img) { transform: scale(1.06); transition: transform 7.5s ease-out; }
    .slide.is-active :global(img) { transform: scale(1); }
  }
  .hero-text { position: absolute; left: 0; bottom: 0; z-index: 1; background: var(--paper); padding: 38px 56px 34px var(--gutter); max-width: calc(100% - 2 * var(--gutter)); }
  .hero h1 { font-family: var(--hatton); font-weight: 400; font-size: 64px; line-height: 1.08; }
  .hero-text p { margin-top: 8px; font-family: var(--text); font-size: 26px; line-height: 1.4; }
  .hero-meta { position: absolute; right: var(--gutter); bottom: 40px; display: flex; align-items: center; gap: 14px; font-family: var(--display-wix); font-size: 13px; letter-spacing: 1.3px; text-transform: uppercase; }
  .hero-caption { background: var(--paper); padding: 7px 12px; border-radius: 999px; }
  .hero-pause { width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--ink); background: var(--paper); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .hero-pause svg { width: 14px; height: 14px; }
  .hero-pause path { fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hero-pause .ico-play { display: none; fill: var(--ink); }
  .hero.is-paused .hero-pause .ico-play { display: block; }
  .hero.is-paused .hero-pause .ico-pause { display: none; }

  /* ---------- 2. Intro ---------- */
  .intro { padding: 110px 20px 120px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .intro h2 { max-width: 700px; font-family: var(--display-wix); font-weight: 700; font-size: 45px; line-height: 63px; }
  .intro h3 { max-width: 700px; margin-top: 17px; font-family: var(--display-wix); font-weight: 700; font-size: 22.5px; line-height: 31.5px; }
  .intro p { max-width: 788px; margin-top: 20px; font-family: var(--display-wix); font-size: 20px; line-height: 28px; }
  .intro p.strong { font-family: var(--display); font-weight: 700; }
  .intro :global(.intro-btn) { margin-top: 34px; }

  /* ---------- Titres de section ---------- */
  .projets-head, .insta-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 36px; }
  .projets h2, .insta h2 { font-family: var(--hatton); font-weight: 400; font-size: 48px; line-height: 1.15; }
  .projets h2 span, .insta h2 span { font-family: var(--hatton-light); font-weight: 700; }
  .lien { font-family: var(--text); font-size: 16px; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; white-space: nowrap; }
  .lien:hover { text-decoration-thickness: 2px; }

  /* ---------- 3. Réalisations ---------- */
  .projets { padding: 0 var(--gutter) 120px; }
  .rangee { display: grid; gap: 10px; height: 440px; }
  .rangee + .rangee { margin-top: 10px; }
  .r-cannes { grid-template-columns: 1fr 1fr 2fr; }
  .r-maison { grid-template-columns: 2fr 1fr 1fr; }
  .r-avap { grid-template-columns: repeat(4, 1fr); height: 300px; }
  .tuile { position: relative; display: block; overflow: hidden; background: var(--grey); }
  .tuile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .tuile:hover :global(img) { transform: scale(1.035); }
  .tuile-texte { position: absolute; left: 0; bottom: 0; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; background: var(--paper); color: var(--ink); padding: 20px 26px 22px; }
  .tuile-nom { font-family: var(--hatton); font-size: 32px; line-height: 1.1; }
  .pill {
    display: inline-flex; align-items: center; height: 30px; padding: 0 16px; border-radius: 999px; white-space: nowrap;
    background: var(--ink); color: var(--paper); border: 1px solid var(--ink);
    font-family: var(--display); font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase;
    transition: background-color .2s, color .2s;
  }
  .tuile:hover .pill { background: var(--paper); color: var(--ink); }
  .etiquette {
    position: absolute; left: 14px; top: 14px; z-index: 1; height: 26px; padding: 0 12px; border-radius: 999px;
    display: inline-flex; align-items: center; background: var(--paper);
    font-family: var(--display); font-weight: 700; font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase;
  }
  .r-avap .tuile-nom { font-size: 24px; }
  .r-avap .tuile-texte { padding: 14px 16px 16px; gap: 10px; }

  /* ---------- 4. Citation ---------- */
  .citation { background: #404734; color: var(--paper); padding: 110px var(--gutter); }
  .citation blockquote { margin: 0 auto; max-width: 980px; text-align: center; }
  .citation p { font-family: var(--hatton); font-size: 34px; line-height: 1.4; }
  .citation footer { margin-top: 34px; font-family: var(--display-wix); font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; }

  /* ---------- 5. Carte projet ---------- */
  .projet-cta { padding: 120px var(--gutter); }
  .carte { max-width: 1100px; margin: 0 auto; background: var(--grey); padding: 64px 72px; display: grid; grid-template-columns: 1fr auto; gap: 60px; align-items: center; }
  .carte h2 { font-family: var(--display); font-weight: 800; font-size: 34px; line-height: 1.2; }
  .carte h2 span { font-family: var(--hatton); font-weight: 400; font-size: 38px; }
  .carte p { margin-top: 18px; max-width: 560px; font-family: var(--text); font-size: 17px; line-height: 1.6; }
  .carte p.devis { margin-top: 12px; font-family: var(--display); font-weight: 700; font-size: 16px; }
  .carte-actions { display: flex; flex-direction: column; align-items: center; gap: 18px; }

  /* ---------- 6. Instagram ---------- */
  .insta { padding: 0 var(--gutter) 110px; }
  .insta-grille { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .insta-tuile { display: block; overflow: hidden; aspect-ratio: 1; background: var(--grey); }
  .insta-tuile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1), opacity .3s; }
  .insta-tuile:hover :global(img) { transform: scale(1.04); opacity: .9; }
  .insta-cta { display: flex; justify-content: center; margin-top: 40px; }

  /* ---------- Tablette ---------- */
  @media (max-width: 1199px) {
    .rangee { height: 360px; }
    .r-avap { height: 240px; }
    .tuile-nom { font-size: 28px; }
    .carte { padding: 52px 48px; gap: 40px; }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 999px) {
    .hero { height: min(640px, calc(100svh - 74px)); min-height: 520px; }
    .hero-text { padding: 22px 26px 20px var(--gutter); max-width: calc(100% - var(--gutter)); }
    .hero h1 { font-size: 34px; }
    .hero-text p { font-size: 17px; margin-top: 6px; }
    .hero-meta { left: auto; right: var(--gutter); top: 18px; bottom: auto; gap: 8px; font-size: 10px; letter-spacing: .9px; }
    .hero-caption { padding: 6px 10px; }

    .intro { padding: 56px 18px 64px; }
    .intro h2 { max-width: 345px; font-family: var(--display); font-size: 30px; line-height: 36px; }
    .intro h3 { max-width: 352px; margin-top: 16px; font-size: 20px; line-height: 28px; }
    .intro p { max-width: 352px; margin-top: 15px; font-size: 16px; line-height: 22.4px; }
    .intro p.strong { margin-top: 20px; }
    .intro :global(.intro-btn) { margin-top: 30px; }

    .projets-head, .insta-head { flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 24px; }
    .projets h2, .insta h2 { font-size: 34px; }
    .projets { padding-bottom: 72px; }
    .rangee { height: 320px; gap: 8px; }
    .r-avap { height: 210px; }
    .rangee + .rangee { margin-top: 8px; }
    .tuile-texte { padding: 14px 18px 16px; gap: 10px; }
    .tuile-nom, .r-avap .tuile-nom { font-size: 24px; }
    .r-avap .tuile-texte { padding: 10px 12px 12px; gap: 8px; }
    .r-avap .tuile-nom { font-size: 18px; }
    .r-avap .pill { display: none; }

    .citation { padding: 64px 22px; }
    .citation p { font-size: 22px; }
    .citation footer { margin-top: 24px; font-size: 11px; }

    .projet-cta { padding: 72px var(--gutter); }
    .carte { grid-template-columns: 1fr; padding: 36px 24px; gap: 28px; }
    .carte h2 { font-size: 26px; }
    .carte h2 span { font-size: 30px; }
    .carte p { font-size: 16px; }
    .carte-actions { align-items: flex-start; }

    .insta { padding-bottom: 72px; }
    .insta-grille { grid-template-columns: 1fr 1fr; gap: 8px; }
    .insta-tuile:nth-child(5) { display: none; }
    .insta-cta { margin-top: 28px; }
  }
  @media (max-width: 599px) {
    .rangee, .r-avap { height: auto; grid-template-columns: 1fr 1fr; }
    .tuile { aspect-ratio: 3 / 4; }
    .tuile.large { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
    .r-avap .tuile { aspect-ratio: 1; }
    .r-maison .tuile.large { order: -1; }
  }
</style>
